    {
      "id": 14,
      "type": "bargauge",
      "title": "Funnel: activation (step-to-step conversion %)",
      "description": "Bad: a low % means most people stop between those two steps (above 100% = the step repeats per user); fix the screen between them first.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
