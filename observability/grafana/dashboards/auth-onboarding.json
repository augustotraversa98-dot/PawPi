      "type": "table",
      "title": "Auth routes: errors by route and class",
      "description": "Bad: 5xx rows are server bugs (fix); lots of 401/4xx on one route can be a broken session or a client retry loop.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
