    {
      "id": 13,
      "type": "bargauge",
      "title": "Funnel: activation (users reaching each step)",
      "description": "Bad: a step far below the one before it is where people give up (activation steps count once per install); open that screen/flow and fix the friction.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(pawpi_funnel_step_total{funnel=\"activation\", step=\"welcome_view\"}[$__range]))",
          "legendFormat": "welcome_view",
          "instant": true,
          "range": false
