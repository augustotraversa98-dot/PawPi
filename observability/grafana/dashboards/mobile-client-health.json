        "w": 24,
        "x": 0,
        "y": 20
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "API failure rate by area (5xx or no response)",
      "description": "Bad: above 2% on an area means phones fail there; compare with the server 5xx panel (same = server bug, only here = network or client).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * sum by (area) (increase(pawpi_client_api_calls_total{status_class=~\"5xx|unknown\", app_version=~\"$app_version\"}[$__rate_interval])) / sum by (area) (increase(pawpi_client_api_calls_total{app_version=~\"$app_version\"}[$__rate_interval]))",
          "legendFormat": "{{area}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "API calls by status class",
      "description": "Bad: growing 4xx can be an expired-session loop or a client sending bad requests; growing 5xx is a server problem.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (status_class) (increase(pawpi_client_api_calls_total{app_version=~\"$app_version\"}[$__rate_interval]))",
