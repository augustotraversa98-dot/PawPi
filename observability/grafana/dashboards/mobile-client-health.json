    {
      "id": 16,
      "type": "stat",
      "title": "Startup p95",
      "description": "Bad: above 3 s means a slow cold start (users think the app is broken); check boot work and the first API calls (bucket resolution).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
