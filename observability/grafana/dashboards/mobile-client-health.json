    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Client vs server API failures",
      "description": "Bad: client failures far above server 5xx means failures between phone and server (network, timeouts, HTML responses); compare the two lines.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * sum(increase(pawpi_client_api_calls_total{status_class=~\"5xx|unknown\", app_version=~\"$app_version\"}[$__rate_interval])) / sum(increase(pawpi_client_api_calls_total{app_version=~\"$app_version\"}[$__rate_interval]))",
