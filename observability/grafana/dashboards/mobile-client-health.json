            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Client-observed API p95 by area",
      "description": "Bad: above 3 s on phones (bucket resolution) means users wait; if the server p95 is fine, suspect network or payload size.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, area) (rate(pawpi_client_api_duration_seconds_bucket{app_version=~\"$app_version\"}[$__rate_interval])))",
          "legendFormat": "{{area}}"
        }
      ],
      "fieldConfig": {
