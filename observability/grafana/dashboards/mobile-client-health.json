        "valueMode": "color",
        "namePlacement": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "sizing": "auto"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Errors by screen, kind and version",
      "description": "Bad: repeated rows are recurring bugs; fix the highest count first, then confirm the line drops after the release.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(20, sum by (screen, kind, app_version) (increase(pawpi_client_errors_total{app_version=~\"$app_version\"}[$__range])))",
