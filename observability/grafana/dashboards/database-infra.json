      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * (1 - sum(rate(pawpi_db_query_duration_seconds_bucket{le=\"0.25\"}[$__rate_interval])) / sum(rate(pawpi_db_query_duration_seconds_count[$__rate_interval])))",
