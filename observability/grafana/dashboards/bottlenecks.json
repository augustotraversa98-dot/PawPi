    {
      "id": 15,
      "type": "stat",
      "title": "Slow-DB-op share (> 250 ms)",
      "description": "Bad: above 5% of queries slower than 250 ms; check the slow op below, add indexes or caching.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * (1 - sum(rate(pawpi_db_query_duration_seconds_bucket{le=\"0.25\"}[$__range])) / sum(rate(pawpi_db_query_duration_seconds_count[$__range])))",
          "legendFormat": "slow %",
          "instant": true,
          "range": false
        }
      ],
