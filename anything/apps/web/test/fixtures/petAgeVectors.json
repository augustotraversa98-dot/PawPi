{
  "_about": "Shared test vectors for a pet's age. Read by the web unit test, the SQL integration test and the mobile jest test. Precedence: exact birthday, then anchored estimate (grows from age_estimated_on), then the stored age (unchanged). 'serverOnly' cases check how stored rows are read; the app only receives rows the server has already checked.",
  "cases": [
    { "name": "estimate of 2 years given in November 2026, same day", "today": "2026-11-15", "pet": { "age_estimate_months": 24, "age_estimated_on": "2026-11-15", "age_years": 2, "age_months": 0 }, "expected": { "years": 2, "months": 0, "approximate": true } },
    { "name": "estimate of 2 years given in November 2026, the day before one year later", "today": "2027-11-14", "pet": { "age_estimate_months": 24, "age_estimated_on": "2026-11-15", "age_years": 2, "age_months": 0 }, "expected": { "years": 2, "months": 11, "approximate": true } },
    { "name": "estimate of 2 years given in November 2026 reads 3 years in November 2027", "today": "2027-11-15", "pet": { "age_estimate_months": 24, "age_estimated_on": "2026-11-15", "age_years": 2, "age_months": 0 }, "expected": { "years": 3, "months": 0, "approximate": true } },
    { "name": "estimate with months crossing a year boundary", "today": "2027-01-10", "pet": { "age_estimate_months": 11, "age_estimated_on": "2026-12-10", "age_years": 0, "age_months": 11 }, "expected": { "years": 1, "months": 0, "approximate": true } },
    { "name": "estimate stored as months only, more than 12", "today": "2026-11-15", "pet": { "age_estimate_months": 18, "age_estimated_on": "2026-11-15", "age_years": null, "age_months": 18 }, "expected": { "years": 1, "months": 6, "approximate": true } },
    { "name": "estimate of zero months is known and approximate", "today": "2026-11-15", "pet": { "age_estimate_months": 0, "age_estimated_on": "2026-11-15", "age_years": 0, "age_months": 0 }, "expected": { "years": 0, "months": 0, "approximate": true } },
    { "name": "estimate of zero months grows", "today": "2027-02-15", "pet": { "age_estimate_months": 0, "age_estimated_on": "2026-11-15", "age_years": 0, "age_months": 0 }, "expected": { "years": 0, "months": 3, "approximate": true } },
    { "name": "estimate given on a month end, shorter next month not yet complete", "today": "2027-02-28", "pet": { "age_estimate_months": 12, "age_estimated_on": "2027-01-31", "age_years": 1, "age_months": 0 }, "expected": { "years": 1, "months": 0, "approximate": true } },
    { "name": "estimate given on a month end, completes on the first day after", "today": "2027-03-01", "pet": { "age_estimate_months": 12, "age_estimated_on": "2027-01-31", "age_years": 1, "age_months": 0 }, "expected": { "years": 1, "months": 1, "approximate": true } },
    { "name": "estimate given on a leap day, one year later in a common year", "today": "2029-02-28", "pet": { "age_estimate_months": 24, "age_estimated_on": "2028-02-29", "age_years": 2, "age_months": 0 }, "expected": { "years": 2, "months": 11, "approximate": true } },
    { "name": "estimate dated after today never goes below the estimate", "today": "2026-11-14", "pet": { "age_estimate_months": 24, "age_estimated_on": "2026-11-15", "age_years": 2, "age_months": 0 }, "expected": { "years": 2, "months": 0, "approximate": true } },
    { "name": "birthday gives an exact age", "today": "2026-07-15", "pet": { "birthday": "2024-01-15" }, "expected": { "years": 2, "months": 6, "approximate": false } },
    { "name": "birthday one day short of the next month", "today": "2026-07-15", "pet": { "birthday": "2024-01-16" }, "expected": { "years": 2, "months": 5, "approximate": false } },
    { "name": "birthday on the anniversary", "today": "2026-07-15", "pet": { "birthday": "2023-07-15" }, "expected": { "years": 3, "months": 0, "approximate": false } },
    { "name": "birthday the day before the anniversary across a new year", "today": "2026-12-31", "pet": { "birthday": "2026-01-01" }, "expected": { "years": 0, "months": 11, "approximate": false } },
    { "name": "birthday on new year", "today": "2027-01-01", "pet": { "birthday": "2026-01-01" }, "expected": { "years": 1, "months": 0, "approximate": false } },
    { "name": "a few weeks old", "today": "2026-11-26", "pet": { "birthday": "2026-11-05" }, "expected": { "years": 0, "months": 0, "approximate": false } },
    { "name": "born today", "today": "2026-11-26", "pet": { "birthday": "2026-11-26" }, "expected": { "years": 0, "months": 0, "approximate": false } },
    { "name": "leap day birthday, last day of February in a common year", "today": "2025-02-28", "pet": { "birthday": "2024-02-29" }, "expected": { "years": 0, "months": 11, "approximate": false } },
    { "name": "leap day birthday, first of March in a common year", "today": "2025-03-01", "pet": { "birthday": "2024-02-29" }, "expected": { "years": 1, "months": 0, "approximate": false } },
    { "name": "leap day birthday on the next leap day", "today": "2028-02-29", "pet": { "birthday": "2024-02-29" }, "expected": { "years": 4, "months": 0, "approximate": false } },
    { "name": "birthday in the future is never negative", "today": "2026-11-26", "pet": { "birthday": "2030-01-01" }, "expected": { "years": 0, "months": 0, "approximate": false } },
    { "name": "birthday as an ISO datetime keeps its calendar date", "today": "2026-07-15", "pet": { "birthday": "2024-07-15T00:00:00.000Z" }, "expected": { "years": 2, "months": 0, "approximate": false } },
    { "name": "birthday wins over an estimate and a stored age", "today": "2026-07-15", "pet": { "birthday": "2024-07-15", "age_estimate_months": 120, "age_estimated_on": "2020-01-01", "age_years": 10, "age_months": 0 }, "expected": { "years": 2, "months": 0, "approximate": false } },
    { "name": "a 1970 placeholder birthday is ignored", "today": "2026-07-15", "pet": { "birthday": "1970-01-01", "age_years": 4, "age_months": 0 }, "expected": { "years": 4, "months": 0, "approximate": true } },
    { "name": "stored age with no estimate date stays unchanged", "today": "2026-11-15", "pet": { "age_years": 13, "age_months": 3 }, "expected": { "years": 13, "months": 3, "approximate": true } },
    { "name": "stored age is still unchanged years later", "today": "2036-11-15", "pet": { "age_years": 13, "age_months": 3, "age_estimate_months": null, "age_estimated_on": null }, "expected": { "years": 13, "months": 3, "approximate": true } },
    { "name": "stored years only", "today": "2026-11-15", "pet": { "age_years": 5, "age_months": null }, "expected": { "years": 5, "months": 0, "approximate": true } },
    { "name": "stored months only are not rolled into years", "today": "2026-11-15", "pet": { "age_years": null, "age_months": 18 }, "expected": { "years": 0, "months": 18, "approximate": true } },
    { "name": "stored zeros read as unknown", "today": "2026-11-15", "pet": { "age_years": 0, "age_months": 0 }, "expected": null },
    { "name": "nothing known", "today": "2026-11-15", "pet": {}, "expected": null },
    { "name": "estimate left behind by a later change of the stored age is not used", "serverOnly": true, "today": "2028-01-01", "pet": { "age_estimate_months": 24, "age_estimated_on": "2026-11-15", "age_years": 5, "age_months": 0 }, "expected": { "years": 5, "months": 0, "approximate": true } },
    { "name": "estimate left behind after the stored age was cleared", "serverOnly": true, "today": "2028-01-01", "pet": { "age_estimate_months": 24, "age_estimated_on": "2026-11-15", "age_years": null, "age_months": null }, "expected": null }
  ]
}
