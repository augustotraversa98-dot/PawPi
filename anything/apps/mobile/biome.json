{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "files": {
    "includes": [
      "**/*.{js,jsx,ts,tsx}",
      "!**/node_modules",
      "!**/.expo",
      "!**/.metro-virtual",
      "!**/caches",
      "!**/dist",
      "!**/web-build",
      "!**/ios",
      "!**/android"
    ]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": { "noNestedComponentDefinitions": "error" }
    }
  }
}
