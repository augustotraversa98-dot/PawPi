{
  "expo": {
    "name": "PawPi",
    "slug": "pawpi",
    "scheme": "pawpi",
    "version": "1.0.0",
    "scheme": "pawpi",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/e1ab38b2-5f41-4d15-bc18-64c8b0717a3d",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.0",
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pawpi.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["en", "es"],
        "NSLocationWhenInUseUsageDescription": "PawPi uses your location to find nearby pet-friendly places, vets, walkers and meetups, to set a location on social walks, transport and events, and to share your live location while you drive a pet-taxi trip.",
        "NSCameraUsageDescription": "PawPi uses the camera so you can take photos of your pet for their profile, daily moments, health checks and vet records.",
        "NSPhotoLibraryUsageDescription": "PawPi accesses your photo library so you can choose photos and documents for your pet's profile, posts, health records and chats.",
        "NSPhotoLibraryAddUsageDescription": "PawPi saves photos you create in the app, such as your pet's shareable daily-moment frame, to your photo library.",
        "NSMicrophoneUsageDescription": "PawPi uses the microphone for audio in vet telehealth video consultations.",
        "NSCalendarsFullAccessUsageDescription": "PawPi adds your pet's appointments, bookings and reminders to your calendar so you don't miss them.",
        "NSCalendarsUsageDescription": "PawPi adds your pet's appointments, bookings and reminders to your calendar so you don't miss them."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF6F61"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.pawpi.app"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF6F61"
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "@bacons/apple-targets"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false,
        "sitemap": false
      },
      "eas": {
        "projectId": "e1ab38b2-5f41-4d15-bc18-64c8b0717a3d"
      }
    },
    "owner": "augusto-firulais"
  }
}
