{
	"cli": {
		"version": ">= 15.0.15",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"channel": "development",
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"channel": "preview",
			"distribution": "internal"
		},
		"production": {
			"channel": "production",
			"autoIncrement": true,
			"env": {
				"EXPO_PUBLIC_BASE_URL": "https://pawpi-production.up.railway.app",
				"EXPO_PUBLIC_PROXY_BASE_URL": "https://pawpi-production.up.railway.app",
				"EXPO_PUBLIC_HOST": "pawpi-production.up.railway.app",
				"EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://pawpi.info/privacy",
				"EXPO_PUBLIC_TERMS_URL": "https://pawpi.info/terms",
				"EXPO_PUBLIC_EULA_URL": "https://pawpi.info/eula",
				"EXPO_PUBLIC_HELP_URL": "https://pawpi.info/support"
			},
			"android": {
				"buildType": "app-bundle"
			}
		}
	},
	"submit": {
		"production": {
			"ios": {
				"appleId": "REPLACE_WITH_APPLE_ID_EMAIL",
				"ascAppId": "6785949610",
				"appleTeamId": "YHQ4T9T96K"
			},
			"android": {
				"serviceAccountKeyPath": "./google-service-account.json",
				"track": "internal",
				"releaseStatus": "draft",
				"changesNotSentForReview": false
			}
		}
	}
}
